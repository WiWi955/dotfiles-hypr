#!/bin/bash
# Regenerate the "wiwi" Omarchy theme colors from the current wallpaper with
# matugen (Material You), like the old dotfiles-hypr setup did.
# Triggered by ~/.config/systemd/user/wiwi-wallpaper-colors.path.

set -euo pipefail

STATE="$HOME/.local/state/omarchy/current"
THEME_DIR="$HOME/.config/omarchy/themes/wiwi"
LAST="$HOME/.local/state/wiwi-wallpaper-colors.last"

sleep 0.5 # let the background/theme switch settle

[[ $(cat "$STATE/theme.name" 2>/dev/null) == wiwi ]] || exit 0

image=$(readlink -f "$STATE/background") || exit 0
[[ -f $image ]] || exit 0

# Same image (by content) as last time: nothing to do. This also stops the
# theme refresh below from re-triggering us.
sum=$(sha1sum "$image" | cut -d' ' -f1)
[[ $sum == $(cat "$LAST" 2>/dev/null) ]] && exit 0

json=$(matugen image "$image" -m dark --json hex --dry-run --source-color-index 0 2>/dev/null)
c() { jq -r ".colors.$1.dark.color" <<<"$json"; }

cat >"$THEME_DIR/colors.toml" <<TOML
# Generated by wiwi-wallpaper-colors from $(basename "$image") — do not edit.
mode = "dark"

accent = "$(c primary)"
selection = "$(c secondary_container)"
muted = "$(c outline_variant)"

background = "$(c surface)"
dark_background = "$(c surface_container_low)"
darker_background = "$(c surface_container_lowest)"
lighter_background = "$(c surface_container_high)"

foreground = "$(c on_surface)"
dark_foreground = "$(c outline)"
light_foreground = "$(c on_surface_variant)"
bright_foreground = "$(c inverse_surface)"

red = "$(c error)"
yellow = "$(c tertiary)"
orange = "$(c error)"
green = "$(c primary)"
cyan = "$(c secondary)"
blue = "$(c primary_fixed)"
magenta = "$(c secondary_fixed)"
brown = "$(c tertiary_container)"

bright_red = "$(c error)"
bright_yellow = "$(c tertiary)"
bright_green = "$(c primary)"
bright_cyan = "$(c secondary)"
bright_blue = "$(c primary_fixed)"
bright_magenta = "$(c secondary_fixed)"
TOML

echo "$sum" >"$LAST"
omarchy-theme-refresh
